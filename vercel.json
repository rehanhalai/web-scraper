{
  "version": 2,
  "installCommand": "npm run install:all",
  "buildCommand": "npm run build",
  "outputDirectory": "apps/web/dist",
  "rewrites": [
    {
      "source": "/scraper/(.*)",
      "destination": "/api"
    },
    {
      "source": "/((?!api|scraper).*)",
      "destination": "/index.html"
    }
  ]
}
